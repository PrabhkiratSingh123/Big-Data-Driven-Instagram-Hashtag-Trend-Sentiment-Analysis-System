# =============================================================
# SocialTrendML — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# OBTAINING INSTAGRAM API CREDENTIALS:
# 1. Create a Meta Developer account at https://developers.facebook.com
# 2. Create a new App → select "Business" type
# 3. Add the "Instagram Graph API" product
# 4. Connect a Facebook Page linked to an Instagram Professional Account
# 5. Generate a User Access Token with instagram_basic + instagram_manage_insights
# 6. Find your Instagram Business Account ID:
#    GET /me/accounts → Page ID → GET /{page-id}?fields=instagram_business_account
# 7. The instagram_business_account.id is your INSTAGRAM_USER_ID
#
# The access token expires. Use the Access Token Debugger to extend it:
#   https://developers.facebook.com/tools/debug/accesstoken/
# =============================================================

# --- Instagram Graph API ---
# REQUIRED for live data collection. Leave empty to run in demo mode.
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=17841448764193411
META_GRAPH_API_VERSION=v21.0

# --- MongoDB Configuration ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=socialtrendml

# --- Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=instagram-posts

# --- Collection Settings ---
COLLECTION_INTERVAL_SECONDS=300
DEFAULT_HASHTAGS=technology,artificialintelligence,datascience,sports

# --- FastAPI ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- Spark Configuration ---
SPARK_MASTER=local[*]
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# --- Logging ---
LOG_LEVEL=INFO
